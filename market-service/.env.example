# Market Service Environment Configuration

# Application
APP_NAME=OutfitStyle Market Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@postgres:5432/market
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://:redis_secret_password_change_in_production@redis:6379
REDIS_CACHE_TTL=300
REDIS_CART_TTL=86400

# ML Service Integration
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT=30

# Main API Service Integration
API_SERVICE_URL=http://api:8080
API_SERVICE_TIMEOUT=10

# Payment Integration (YooKassa)
PAYMENT_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Product Scraper (pyRustScraperApi)
PYRUSTSCRAPERAPI_TOKEN=
PRODUCT_IMPORT_LIMIT_PER_DAY=10

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
