[run]
source = api,model,services,contracts
omit = 
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*
    */site-packages/*
    */conftest.py
    */test_*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

show_missing = True
precision = 2
