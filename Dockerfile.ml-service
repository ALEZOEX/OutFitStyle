FROM python:3.11-slim

# Set locale to UTF-8
ENV LANG=ru_RU.UTF-8
ENV LC_ALL=ru_RU.UTF-8
ENV PYTHONIOENCODING=utf-8

WORKDIR /app

# Install system dependencies for matplotlib and other packages
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    pkg-config \
    libfreetype6-dev \
    libpng-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libxcb1-dev \
    libopenblas-dev \
    liblapack-dev \
    gfortran \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY ml-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the ML service code (includes contracts subdirectory)
COPY ml-service/ ./

# Ensure models directory exists
RUN mkdir -p /app/models

# Models will be mounted as a volume, so we don't need to copy them in the Dockerfile
# Just create a dummy model file if no models are mounted
RUN python -c "import pickle; pickle.dump({'dummy': True}, open('/app/models/model.pkl', 'wb'))" && \
    echo "Dummy model created for build purposes"

# Also create the model file in the expected relative location for the application
RUN mkdir -p /app/api/models && \
    if [ -f /app/models/model.pkl ]; then \
        cp /app/models/model.pkl /app/api/models/model.pkl; \
    else \
        python -c "import pickle; pickle.dump({'dummy': True}, open('/app/api/models/model.pkl', 'wb'))"; \
    fi

# Expose port
EXPOSE 8000

# Add the app directory to PYTHONPATH so that contracts module can be found
ENV PYTHONPATH=/app:$PYTHONPATH

# Set the working directory and run the application
WORKDIR /app/api
CMD ["python", "main.py"]