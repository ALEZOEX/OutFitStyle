# По умолчанию нормализуем текст и храним в репо LF
* text=auto eol=lf

# Windows-скрипты — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix-скрипты — LF
*.sh text eol=lf

# Go файлы — LF
*.go text eol=lf

# Python файлы — LF
*.py text eol=lf

# JSON файлы — LF
*.json text eol=lf

# YAML файлы — LF
*.yml text eol=lf
*.yaml text eol=lf

# Docker файлы — LF
Dockerfile* text eol=lf
*.dockerfile text eol=lf

# Конфигурационные файлы — LF
*.conf text eol=lf
*.ini text eol=lf
*.env* text eol=lf

# Текстовые файлы — LF
*.txt text eol=lf
*.md text eol=lf

# ML модели и датасеты — binary (не трогать окончания строк)
*.pkl binary
*.onnx binary
*.pt binary
*.h5 binary
*.joblib binary
*.pickle binary

# Датасеты — binary
*.csv binary
*.parquet binary
*.arrow binary

# Использовать Git LFS для моделей
*.pkl filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text

# Архивы — binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary

# Изображения — binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.bmp binary
*.svg binary

# Двоичные файлы — binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary