# Database configuration (уменьшенные требования)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=outfitstyle

# JWT Configuration (should be at least 32 characters long)
JWT_SECRET=supersecretjwtkeyforlocaldevelopment32chars

# Yandex Translate API Key (get from Yandex Cloud)
YANDEX_TRANSLATE_API_KEY=aje36hbuc3e2ntrh5e21
YANDEX_FOLDER_ID=

# Weather API Configuration - используем пустое значение для локальной разработки
WEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=5000
ML_SERVICE_TIMEOUT=30s

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Queue Configuration
QUEUE_REDIS_URL=redis://redis:6379

# Kafka Configuration (for event streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=outfitstyle-events
EVENTING_ENABLED=0

# Server Configuration (уменьшенные требования)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development

# Database Connection Pool Configuration
DATABASE_MAX_CONNECTIONS=5
DATABASE_MAX_IDLE_CONNECTIONS=2

# Authentication Configuration
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
CORS_ALLOWED_ORIGINS=*

# Weather Provider Configuration
WEATHER_PROVIDER=openweather
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENWEATHER_CACHE_TTL=5m

# Google OAuth Configuration - используем пустое значение для локальной разработки
GOOGLE_CLIENT_ID=

# Admin API Key
ADMIN_API_KEY=local_admin_key

# SMTP Configuration - используем реальные данные, но с безопасными настройками
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=OutFitStyle.official.app@gmail.com
SMTP_PASSWORD=bkvf huqi umeb zipd
FROM_EMAIL=noreply@outfitstyle.com
SMTP_TLS=true
SMTP_DEBUG=false

# Feature Flags
FEATURE_PARTNER_CATALOG=false
FEATURE_AB_TESTING=false
FEATURE_ACHIEVEMENTS=false
FEATURE_TRIPS=false

# Security
API_KEY_PEPPER=dev-pepper

# Logging (уменьшенный уровень)
LOG_LEVEL=warn

# Event Logging
ENABLE_EVENT_LOGGING=0

# Translation Cache Configuration
TRANSLATION_CACHE_TTL=86400
TRANSLATION_REDIS_HOST=redis
TRANSLATION_REDIS_PORT=6379