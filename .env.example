# OutFitStyle Environment Configuration
# СКОПИРУЙТЕ этот файл в .env и сгенерируйте секреты!

# ===========================================
# GITHUB: https://github.com/ALEZOX/OutFitStyle
# ===========================================

# ===========================================
# Server Configuration
# ===========================================
ENVIRONMENT=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgres://outfitstyle:outfitstyle@localhost:5432/outfitstyle?sslmode=disable

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379/1

# ===========================================
# JWT Configuration - ГЕНЕРИРУЙТЕ СЕКРЕТЫ!
# ===========================================
# Сгенерируйте случайный секрет командой:
# openssl rand -base64 64
# или используйте: https://randomkeygen.com/
# Security: минимум 256 бит (32 байта) для HMAC-SHA256
# Security: используйте разные ключи для access и refresh токенов
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_256_BITS

# Security: короткий TTL для access токена (15 минут)
# Это уменьшает окно атаки при утечке токена
JWT_ACCESS_TOKEN_TTL=15m

# Refresh token TTL - 30 дней (баланс между удобством и безопасностью)
JWT_REFRESH_TOKEN_TTL=720h

# Для production рекомендуется использовать RS256 (асимметричные ключи)
# Генерация ключей:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# JWT_USE_RS256=true
# JWT_PRIVATE_KEY_PATH=config/jwt/private.pem
# JWT_PUBLIC_KEY_PATH=config/jwt/public.pem

# ===========================================
# API Keys
# ===========================================
# Сгенерируйте API ключ командой:
# openssl rand -hex 32
API_KEY_PEPPER=REPLACE_WITH_SECURE_RANDOM_PEPPER

# Admin API Key - сгенерируйте случайный ключ
ADMIN_API_KEY=REPLACE_WITH_SECURE_ADMIN_KEY

# OpenWeather API Key (получите на openweathermap.org)
OPENWEATHER_API_KEY=
OPENWEATHER_CACHE_TTL=10m
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ===========================================
# ML Service Configuration
# ===========================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30s

# ===========================================
# CORS Configuration
# ===========================================
# Укажите конкретные разрешённые origin вместо *
# Security: для httpOnly cookie необходим конкретный origin (не *)
# AllowCredentials: true требует whitelist origin
CORS_ALLOWED_ORIGINS=https://outfitstyle.app,https://api.outfitstyle.app,http://localhost:8080,http://127.0.0.1:8080

# ===========================================
# Security Configuration
# ===========================================
# Включите SSL для production
DB_SSL_MODE=disable

# ===========================================
# Monitoring
# ===========================================
SENTRY_DSN=

# ===========================================
# Firebase Configuration
# ===========================================
FIREBASE_PROJECT_ID=outfitstyle-ce15f
FIREBASE_APP_ID_WEB=1:242419520610:web:4a7393ff88f9727ecc2d3b
FIREBASE_MESSAGING_SENDER_ID=242419520610

# Firebase Admin SDK Credentials (Service Account Key)
# Получить Service Account Key:
# 1. Откройте Firebase Console → Project Settings → Service Accounts
# 2. Нажмите "Generate new private key"
# 3. Сохраните JSON файл и укажите путь ниже
# Для production используйте FIREBASE_CREDENTIALS_PATH с путём к файлу
# FIREBASE_CREDENTIALS_PATH=config/firebase/service-account-key.json
# Для development можно использовать JSON напрямую (не рекомендуется для production):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ===========================================
# Development Only - НЕ ИСПОЛЬЗОВАТЬ В PRODUCTION!
# ===========================================
# Эти значения ТОЛЬКО для локальной разработки
# В production используйте реальные секреты!
DEV_DB_PASSWORD=outfitstyle
DEV_REDIS_PASSWORD=
