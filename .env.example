# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=outfitstyle

# JWT Configuration (should be at least 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_change_in_production

# Yandex Translate API Key (get from Yandex Cloud)
YANDEX_TRANSLATE_API_KEY=your_yandex_translate_api_key

# Weather API Configuration
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ML Service Configuration
ML_SERVICE_URL=http://localhost:5000

# Redis Configuration
REDIS_URL=redis://localhost:6379

# SMTP Configuration (optional, for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=your_email@gmail.com

# Server Configuration
PORT=8080
HOST=localhost

# Logging
LOG_LEVEL=info