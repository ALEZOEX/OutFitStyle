# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=outfitstyle

# JWT Configuration (should be at least 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_change_in_production

# JWT RS256 Configuration (asymmetric signing - recommended for production)
# Set JWT_USE_RS256=true to enable RS256 instead of HS256
JWT_USE_RS256=false
JWT_PRIVATE_KEY_PATH=config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=config/jwt/public.pem

# Yandex Translate API Key (get from Yandex Cloud)
YANDEX_TRANSLATE_API_KEY=your_yandex_translate_api_key
YANDEX_FOLDER_ID=your_yandex_folder_id

# Weather API Configuration
WEATHER_API_KEY=your_openweathermap_api_key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ML Service Configuration
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_PORT=5000
ML_SERVICE_TIMEOUT=30s

# ML Fallback Configuration (graceful degradation)
ML_FALLBACK_ENABLED=true
ML_CACHE_TTL=10m
ML_HEALTH_CHECK_TTL=30s
ML_RETRY_ATTEMPTS=2
ML_RETRY_DELAY_MS=500
ML_REQUEST_TIMEOUT=5s
ML_USE_CACHE=true
ML_INVALIDATE_ON_UPDATE=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_change_in_production
REDIS_URL=redis://:your_redis_password_change_in_production@localhost:6379

# Queue Configuration
QUEUE_REDIS_URL=redis://localhost:6379

# =============================================================================
# KAFKA CONFIGURATION (for event streaming)
# =============================================================================

# Kafka Brokers (comma-separated for multiple brokers)
# Для локальной разработки: localhost:9092
# Для Docker: kafka:29092 (внутри сети Docker)
KAFKA_BROKERS=localhost:9092

# Основной топик для событий рекомендаций
KAFKA_TOPIC_RECOMMENDATIONS=recommendations

# Топик для пользовательских событий (клики, просмотры, лайки)
KAFKA_TOPIC_EVENTS=user_events

# Включить eventing (1/true или 0/false)
EVENTING_ENABLED=1

# Конфигурация Kafka для продакшена (опционально)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your_cluster_username
# KAFKA_SASL_PASSWORD=your_cluster_password

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development

# Database Connection Pool Configuration
DATABASE_MAX_CONNECTIONS=100
DATABASE_MAX_IDLE_CONNECTIONS=10

# Authentication Configuration
# Access Token: короткоживущий токен для авторизации запросов (1 час)
# Refresh Token: долгоживущий токен для обновления access токена (90 дней)
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=2160h

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Weather Provider Configuration
WEATHER_PROVIDER=openweather
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENWEATHER_CACHE_TTL=10m

# SMTP Configuration (for email notifications and password reset)
# For Gmail: use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@outfitstyle.app
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=OutfitStyle <noreply@outfitstyle.app>
SMTP_FROM_NAME=OutfitStyle

# Email Template Configuration
# Base URLs for email links
EMAIL_APP_URL=https://outfitstyle.app
EMAIL_RESET_URL=https://outfitstyle.app/reset-password
EMAIL_SUPPORT_URL=https://outfitstyle.app/support
EMAIL_UNSUBSCRIBE_URL=https://outfitstyle.app/unsubscribe

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id

# Admin API Key
ADMIN_API_KEY=your_admin_api_key

# Feature Flags
FEATURE_PARTNER_CATALOG=true
FEATURE_AB_TESTING=true
FEATURE_ACHIEVEMENTS=true

# Security
API_KEY_PEPPER=dev-pepper

# Logging
LOG_LEVEL=info

# Event Logging
ENABLE_EVENT_LOGGING=1
EVENT_LOG_DIR=data/logs

# Translation Cache Configuration
TRANSLATION_CACHE_TTL=86400
TRANSLATION_REDIS_HOST=redis
TRANSLATION_REDIS_PORT=6379

# =============================================================================
# PAYMENTS & SUBSCRIPTIONS CONFIGURATION
# =============================================================================

# YooKassa Payment Gateway Configuration
# Get ShopID and SecretKey from https://yookassa.ru/developers
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3

# Stripe Payment Gateway Configuration (alternative)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Subscription Configuration
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_CURRENCY=RUB

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification
PAYMENT_RETURN_URL=http://localhost:3000/payment/return

# =============================================================================
# STORAGE CONFIGURATION (S3-compatible)
# =============================================================================

# S3 Configuration (for file storage)
S3_ENDPOINT=
S3_BUCKET=outfitstyle-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL=1h

# =============================================================================
# PUSH NOTIFICATIONS CONFIGURATION
# =============================================================================

# Firebase Cloud Messaging (FCM)
# Получите service account key из Firebase Console:
# 1. Откройте https://console.firebase.google.com/
# 2. Выберите ваш проект OutfitStyle
# 3. Settings (шестерёнка) > Project settings
# 4. Вкладка "Service accounts"
# 5. Click "Generate new private key"
# 6. Сохраните JSON файл и укажите путь к нему
# Файл содержит чувствительные данные — не коммитьте в git!
FCM_CREDENTIALS_FILE=config/fcm/serviceAccountKey.json

# Apple Push Notification Service (APNS)
# Для iOS уведомлений
APNS_KEY_FILE=config/apns/AuthKey.p8
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
APNS_BUNDLE_ID=com.outfitstyle.app
APNS_ENVIRONMENT=development

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Sentry Configuration (for error tracking)
SENTRY_DSN=

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# OpenTelemetry Configuration
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# MARKET SERVICE - PRODUCT SCRAPER CONFIGURATION
# =============================================================================

# pyRustScraperApi Token for parsing products from Wildberries/Ozon
# Get token from https://pyrustscraperapi.com/ or leave empty for free tier
PYRUSTSCRAPERAPI_TOKEN=

# Daily import limit per user
PRODUCT_IMPORT_LIMIT_PER_DAY=10