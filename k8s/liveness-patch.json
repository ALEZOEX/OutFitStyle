{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "backend",
            "livenessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 8080,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 45,
              "periodSeconds": 15,
              "timeoutSeconds": 10,
              "failureThreshold": 5
            }
          }
        ]
      }
    }
  }
}
