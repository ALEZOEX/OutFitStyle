# Пример секрета для OutfitStyle
# СКОПИРУЙТЕ ЭТОТ ФАЙЛ В secrets.yaml И ЗАПОЛНИТЕ РЕАЛЬНЫМИ ЗНАЧЕНИЯМИ
# НЕ КОММИТЬТЕ secrets.yaml В GIT!
#
# Генерация паролей:
#   openssl rand -base64 32   (для redis-password, jwt-secret и т.д.)
#   openssl rand -base64 16   (для db-password)
#
# После применения сертификатов cert-manager, обновите database-url:
#   postgresql://user:pass@postgres:5432/db?sslmode=require
#
apiVersion: v1
kind: Secret
metadata:
  name: outfitstyle-secrets
  namespace: outfitstyle
type: Opaque
stringData:
  # ==============================================
  # PostgreSQL
  # ==============================================
  # Connection string с TLS (sslmode=require)
  # sslrootcert задаётся через PGSSLROOTCERT env в backend.yaml
  database-url: "postgresql://outfitstyle:CHANGE_ME@postgres.outfitstyle.svc.cluster.local:5432/outfitstyle?sslmode=require"

  # PostgreSQL credentials
  db-user: "outfitstyle"
  db-password: "CHANGE_ME_USE_OPENSSL_RAND_BASE64_16"
  db-name: "outfitstyle"

  # ==============================================
  # Redis
  # ==============================================
  # Redis URL с TLS (rediss:// = TLS, redis:// = plaintext)
  redis-url: "rediss://redis.outfitstyle.svc.cluster.local:6379"

  # Redis пароль (генерация: openssl rand -base64 32)
  redis-password: "CHANGE_ME_USE_OPENSSL_RAND_BASE64_32"

  # ==============================================
  # JWT
  # ==============================================
  # JWT secret для подписи токенов (минимум 32 случайных символа)
  # Генерация: openssl rand -base64 48
  jwt-secret: "CHANGE_ME_USE_OPENSSL_RAND_BASE64_48"

  # ==============================================
  # External Services
  # ==============================================
  openweather-api-key: "your-openweather-api-key"

  # ==============================================
  # Google / Firebase
  # ==============================================
  google-client-id: "your-google-client-id.apps.googleusercontent.com"

  # Firebase credentials
  firebase-credentials-path: "/etc/firebase/credentials.json"

  # ==============================================
  # Monitoring (Grafana)
  # ==============================================
  grafana-admin-user: "admin"
  grafana-admin-password: "CHANGE_ME_USE_OPENSSL_RAND_BASE64_16"

  # ==============================================
  # S3 Storage
  # ==============================================
  s3-endpoint: "https://s3.example.com"
  s3-access-key: "your-s3-access-key"
  s3-secret-key: "your-s3-secret-key"
