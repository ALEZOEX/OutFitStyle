# Пример секрета для OutfitStyle
# СКОПИРУЙТЕ ЭТОТ ФАЙЛ В secrets.yaml И ЗАПОЛНИТЕ РЕАЛЬНЫМИ ЗНАЧЕНИЯМИ
# НЕ КОММИТЬТЕ secrets.yaml В GIT!
apiVersion: v1
kind: Secret
metadata:
  name: outfitstyle-secrets
  namespace: outfitstyle
type: Opaque
stringData:
  # PostgreSQL connection string для приложения
  database-url: "postgresql://outfitstyle:change-me@postgres:5432/outfitstyle"
  
  # JWT secret для подписи токенов (минимум 32 случайных символа)
  jwt-secret: "change-me-to-random-string-min-32-chars"
  
  # OpenWeather API key для получения погоды
  openweather-api-key: "your-openweather-api-key"
  
  # PostgreSQL credentials (используются в migrate job)
  db-user: "outfitstyle"
  db-password: "change-me-to-secure-password"
  db-name: "outfitstyle"
  
  # Redis connection URL
  redis-url: "redis://redis:6379"

  # Grafana admin credentials
  grafana-admin-user: "admin"
  grafana-admin-password: "change-me-to-secure-password"

  # S3 credentials для хранения изображений
  s3-endpoint: "https://s3.example.com"
  s3-access-key: "change-me-to-s3-access-key"
  s3-secret-key: "change-me-to-s3-secret-key"

  # Google OAuth Client ID для Google Sign-In
  # Получить в Google Cloud Console: https://console.cloud.google.com/apis/credentials
  google-client-id: "your-google-client-id.apps.googleusercontent.com"

  # Firebase Admin SDK credentials для верификации ID токенов
  # Получить в Firebase Console: Project Settings → Service Accounts → Generate new private key
  # Вариант 1: Путь к файлу с credentials (если файл смонтирован в под)
  firebase-credentials-path: "/etc/firebase/credentials.json"
  # Вариант 2: JSON credentials напрямую (base64 encoded для безопасности)
  # firebase-credentials-json: "{\"type\":\"service_account\",\"project_id\":\"...\"}"
