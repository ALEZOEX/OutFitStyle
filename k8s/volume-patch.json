{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "backend",
            "volumeMounts": [
              {
                "name": "firebase-credentials",
                "mountPath": "/etc/firebase",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "firebase-credentials",
            "secret": {
              "secretName": "firebase-credentials-secret"
            }
          }
        ]
      }
    }
  }
}
