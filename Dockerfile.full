# Multi-stage Dockerfile для OutfitStyle - полный стек
# Использование: docker build -f Dockerfile.full -t outfitstyle:latest .
# Запуск: docker-compose up -d

# ==============================================================================
# Этап 1: Build Server (Go)
# ==============================================================================
FROM golang:1.25-alpine AS server-builder

WORKDIR /app

# Установка зависимостей
RUN apk add --no-cache git make

# Копирование go.mod и go.sum
COPY server/go.mod server/go.sum ./
RUN go mod download

# Копирование исходного кода сервера
COPY server/ ./

# Сборка сервера и миграций
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/migrate ./cmd/migrate

# ==============================================================================
# Этап 2: Build ML Service (Python)
# ==============================================================================
FROM python:3.11-slim AS ml-builder

WORKDIR /app

# Установка зависимостей
COPY ml-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копирование кода ML-сервиса
COPY ml-service/ ./

# ==============================================================================
# Этап 3: Production образ
# ==============================================================================
FROM alpine:3.19

# Установка runtime зависимостей
RUN apk add --no-cache \
    ca-certificates \
    curl \
    tzdata \
    && update-ca-certificates

# Настройка временной зоны
ENV TZ=Europe/Moscow

# Создание пользователя для безопасности
RUN addgroup -g 1000 appgroup && \
    adduser -u 1000 -G appgroup -D appuser

WORKDIR /app

# Копирование сервера из builder
COPY --from=server-builder /app/server .
COPY --from=server-builder /app/migrate .

# Копирование ML-сервиса
COPY --from=ml-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=ml-builder /app /app/ml-service

# Копирование конфигов
COPY infrastructure/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/prometheus/prometheus.yml /etc/prometheus/prometheus.yml

# Настройка прав доступа
RUN chown -R appuser:appgroup /app && \
    chmod +x /app/server /app/migrate

USER appuser

# Порты
# 8080 - API сервер
# 8000 - ML сервис
# 80 - nginx
# 9090 - Prometheus

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["/app/server"]
