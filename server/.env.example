# Server configuration
HOST=localhost
PORT=8080
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# CORS configuration - specify exact origins (comma-separated)
# Do NOT use * in production!
CORS_ALLOWED_ORIGINS=https://outfitstyle.app,https://www.outfitstyle.app,http://localhost:3000

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=outfitstyle
DB_SSL_MODE=disable

# Redis configuration
REDIS_URL=redis://localhost:6379
CACHE_EXPIRATION=5m

# Weather API configuration
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_API_TIMEOUT=10

# ML Service configuration
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_TIMEOUT=30s

# Marketplace configuration
MARKETPLACE_TIMEOUT=15s

# Translation API configuration (Yandex)
YANDEX_TRANSLATE_API_KEY=your_yandex_translate_api_key

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Rate limiting configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1s

# Security configuration
JWT_SECRET=your_secure_random_secret_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@outfitstyle.com
SMTP_TLS=true
SMTP_DEBUG=false

# Firebase Configuration
# Получить Service Account Key:
# 1. Откройте Firebase Console → Project Settings → Service Accounts
# 2. Нажмите "Generate new private key"
# 3. Сохраните JSON файл и укажите путь ниже
# FIREBASE_CREDENTIALS_PATH=config/firebase/service-account-key.json
# Или вставьте JSON содержимое напрямую (не рекомендуется для production):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}